# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Configuration (Primary: Groq - Ultra-fast LPU inference)
# Get your free Groq API key from https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here

# AI Configuration (Fallback: OpenRouter - Free models available)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Configuration (Fallback: Direct Gemini AI)
# Get your free Gemini API key from https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Hindsight Configuration (Agent Memory - Required for hackathon features)
# ─────────────────────────────────────────────────────────────────────────────
# 1. Register at https://ui.hindsight.vectorize.io
# 2. Use promo code MEMHACK315 for $50 free credits
# 3. Copy your Cloud Base URL and API Key below
VITE_HINDSIGHT_BASE_URL=https://your-cloud-url.hindsight.vectorize.io
VITE_HINDSIGHT_API_KEY=your_hindsight_api_key_here

