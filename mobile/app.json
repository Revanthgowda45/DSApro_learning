{
  "expo": {
    "name": "DSA Tracker",
    "slug": "dsa-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dsatracker.mobile"
    },
    "android": {
      "package": "com.dsatracker.mobile",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications"
    ],
    "sdkVersion": "51.0.0",
    "platforms": ["ios", "android", "web"],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "jsEngine": "jsc",
    "newArchEnabled": false
  }
}
